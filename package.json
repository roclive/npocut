{
  "name": "npocut",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "dist:win": "npm run prepare:runtime && electron-builder --win nsis zip --x64 --publish never",
    "test:electron": "node scripts/smoke-electron.mjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "playwright": "1.63.0"
  },
  "description": "Local video cutting and subtitle editing for Windows",
  "author": "roclive",
  "license": "MIT",
  "main": "electron/main.js",
  "build": {
    "appId": "com.roclive.npocut",
    "productName": "npocut",
    "files": [
      "electron/**/*",
      "web/**/*",
      "server.js",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!python/Scripts/**",
          "!python/Lib/site-packages/pip/**",
          "!python/Lib/site-packages/pip-*/**"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}"
    },
    "publish": null
  }
}
